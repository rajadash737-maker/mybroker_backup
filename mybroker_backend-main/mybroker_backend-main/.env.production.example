# Production template only. Supply values through the VPS secret manager/environment.
ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@DB_HOST:3306/DATABASE_NAME
DATABASE_ECHO=false
MAX_UPLOAD_SIZE_BYTES=10485760
PRIVATE_UPLOADS_DIR=/var/lib/mybroker/private-uploads
FRONTEND_ORIGINS=https://your-frontend.example
PUBLIC_BASE_URL=https://api.your-domain.example

# Must be a unique, randomly generated value of at least 32 bytes.
JWT_SECRET_KEY=replace_with_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=mybroker-backend
JWT_AUDIENCE=mybroker-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=10

MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_SENDER_ID=replace_with_msg91_sender_id
MSG91_TEMPLATE_ID=replace_with_msg91_template_id
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=

RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
ADMIN_SETUP_KEY=replace_with_one_time_setup_key
OTP_SEND_LIMIT=3
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_SECRET=replace_with_random_secret_at_least_32_bytes
