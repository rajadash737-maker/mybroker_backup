# Local development template. Copy to .env and replace placeholders as needed.
ENVIRONMENT=local
DATABASE_URL=mysql+pymysql://root@localhost:3306/mybroker_db
DATABASE_ECHO=false
MAX_UPLOAD_SIZE_BYTES=10485760
PRIVATE_UPLOADS_DIR=app/private_uploads
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

JWT_SECRET_KEY=replace_with_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=mybroker-backend
JWT_AUDIENCE=mybroker-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=10

MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_SENDER_ID=MYBRKR
MSG91_TEMPLATE_ID=replace_with_msg91_template_id
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Comma-separated Google OAuth client IDs accepted as ID-token audiences.
# Include the Android and/or Web client IDs used by the sign-in flow.
GOOGLE_OAUTH_CLIENT_IDS=

RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
ADMIN_SETUP_KEY=replace_with_one_time_setup_key
OTP_SEND_LIMIT=3
OTP_RATE_WINDOW_SECONDS=900
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_SECRET=replace_with_random_secret_at_least_32_bytes
# Site Visit completion-code keys must be independent, hex-encoded random bytes.
# Encryption: exactly 32 bytes / 64 hex characters. HMAC: at least 32 bytes / 64 hex characters.
SITE_VISIT_OTP_ENCRYPTION_KEY=
SITE_VISIT_OTP_HMAC_KEY=
# Generate a dedicated 32-byte key, hex encoded; do not reuse the Site Visit OTP key.
SITE_VISIT_REFUND_ENCRYPTION_KEY=replace_with_64_hex_characters
LAND_BOOKING_REFUND_ENCRYPTION_KEY=replace_with_a_different_64_hex_character_key
